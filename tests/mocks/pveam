#!/usr/bin/env bash
# Mock: pveam (Proxmox VE Appliance Manager)
set -u
SB_STATE="${SB_STATE:?SB_STATE fehlt}"
mkdir -p "$SB_STATE"
echo "pveam $*" >> "$SB_STATE/calls.log"

cmd="${1:-}"; [[ $# -gt 0 ]] && shift
case "$cmd" in
  update)  echo "update successful"; exit 0 ;;
  available)
    # Format-Zeile, aus der grep -o 'debian-13-standard[^ ]*' das Template zieht
    if [[ "${PVEAM_EMPTY:-0}" == "1" ]]; then exit 0; fi
    echo "local             debian-13-standard_13.2-1_amd64.tar.zst"
    echo "local             debian-12-standard_12.7-1_amd64.tar.zst"
    ;;
  list)
    if [[ -f "$SB_STATE/template-downloaded" ]]; then
      echo "local:vztmpl/debian-13-standard_13.2-1_amd64.tar.zst"
    fi
    ;;
  download)
    echo "pveam $*" >> "$SB_STATE/calls.log"
    touch "$SB_STATE/template-downloaded"
    echo "download finished"
    ;;
  *) echo "mock-pveam: $cmd" >&2; exit 2 ;;
esac
