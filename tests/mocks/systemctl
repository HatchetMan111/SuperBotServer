#!/usr/bin/env bash
# Mock: systemctl – is-active druckt "active" (oder FAIL_SYSTEMCTL=1), Rest aufgezeichnet
set -u
SB_STATE="${SB_STATE:?SB_STATE fehlt}"
mkdir -p "$SB_STATE"
echo "systemctl $*" >> "$SB_STATE/calls.log"

cmd="${1:-}"; [[ $# -gt 0 ]] && shift
case "$cmd" in
  is-active)
    if [[ "${FAIL_SYSTEMCTL:-0}" == "1" ]]; then exit 1; fi
    [[ " $* " == *" --quiet "* ]] || echo "active"
    exit 0
    ;;
  daemon-reload|enable|restart|start|stop) exit 0 ;;
  *) exit 0 ;;
esac
